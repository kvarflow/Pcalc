<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Pcalc" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/calc_background</item>
        <item name="android:colorAccent">@color/calc_red</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Theme.Pcalc.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="postSplashScreenTheme">@style/Theme.Pcalc</item>
    </style>
</resources>
